FROM node:24.18.0-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY app.cjs .
ENV DD_TRACE_ENABLED=true OTEL_TRACES_EXPORTER=otlp \
    OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/json \
    DD_APPSEC_ENABLED=false DD_IAST_ENABLED=false \
    DD_PROFILING_ENABLED=false DD_INSTRUMENTATION_TELEMETRY_ENABLED=false \
    DD_REMOTE_CONFIGURATION_ENABLED=false DD_RUNTIME_METRICS_ENABLED=false
USER 65532:65532
ENTRYPOINT ["node", "/app/app.cjs"]
